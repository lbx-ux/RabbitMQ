<?xml version="1.0" encoding="UTF-8"?>
<!-- lab4-producer：笔记 4.生产者的可靠性 全部实验（生产者重试 / Confirm / Return / 本地消息表） -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.study.labs</groupId>
        <artifactId>mq-labs</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>lab4-producer</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- MyBatis-Plus：本地消息表需要落库（笔记 4.生产者的可靠性 §4.1 表设计） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>3.5.3.1</version>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>
        <!-- Hutool：JSONUtil 工具类（本地消息表 content 的序列化/反序列化） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.25</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
