<?xml version="1.0" encoding="UTF-8"?>
<!-- lab5-consumer：笔记 5.消费者的可靠性 全部实验（确认机制/失败重试/死信兜底/业务幂等） -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.study.labs</groupId>
        <artifactId>mq-labs</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>lab5-consumer</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Redis：幂等方案一的 SETNX 高性能挡板（笔记 §4.2） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- MyBatis-Plus：幂等记录表/短信表/错误消息表 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>3.5.3.1</version>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
